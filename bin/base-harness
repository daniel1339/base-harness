#!/usr/bin/env python3
"""base-harness: plan and measure, installed once per machine.

The project keeps only what an agent has to READ —the contract and the skills—.
What is merely EXECUTED lives here, so a fix in this tool reaches every project
with a `git pull && ./install.sh`, without touching any of them.

    base-harness init [path]     write the contract and the skills into a project
    base-harness upgrade [path]  refresh what belongs to the tool; never AGENTS.md
    base-harness check           fail if a plan is missing its obligations (CI)
    base-harness plans           the same, informational
    base-harness time <slug>     what a plan cost
    base-harness pace            the real pace across closed plans
    base-harness where           which paths it is using
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

# Once installed, `bin/base-harness` is a link to the copy under
# ~/.local/share, and `resolve()` follows it: that is why home is found on its
# own and there is nothing to configure.
HOME = Path(os.environ.get("BASE_HARNESS_HOME") or Path(__file__).resolve().parent.parent)
TEMPLATE = HOME / "template"
sys.path.insert(0, str(HOME))

from base_harness import plan_time, plans_check  # noqa: E402
from base_harness.root import root  # noqa: E402

# Who owns what. What belongs to the tool can be refreshed without asking; what
# belongs to the project is never touched after `init`, because a person wrote
# it and there is no way to merge it without losing something.
TOOL_OWNED = [
    ".claude/skills/create-plan/SKILL.md",
    ".claude/skills/plan-task/SKILL.md",
    ".github/workflows/ci.yml",
    "CLAUDE.md",
]
PROJECT_OWNED = ["AGENTS.md", ".gitignore"]


def template_files() -> list[str]:
    return sorted(
        path.relative_to(TEMPLATE).as_posix()
        for path in TEMPLATE.rglob("*")
        if path.is_file()
    )


def write(relative: str, target: Path) -> None:
    destination = target / relative
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(TEMPLATE / relative, destination)


def cmd_init(target: Path) -> int:
    if not target.is_dir():
        print(f"no such directory: {target}")
        return 1

    clashes = [relative for relative in template_files() if (target / relative).exists()]
    if clashes:
        print("These files already exist in the target. Nothing was touched:")
        for relative in clashes:
            print(f"  {relative}")
        print("\nComing from an earlier version? `base-harness upgrade` refreshes")
        print("what belongs to the tool and leaves AGENTS.md alone.")
        return 1

    for relative in template_files():
        write(relative, target)
    print(f"harness installed in {target}")
    print()

    # git is not optional: `base-harness time` gets collateral work out of
    # `git log`. With no repo it only sees the gaps between tasks, and that half
    # cannot be recovered later, because the commits you did not make do not
    # exist.
    if not (target / ".git").exists():
        print("  WARNING: the target is not a git repository.")
        print("  Measurement reads collateral work from git log; with no repo it")
        print(f'  measures half. Before the first task:  git -C "{target}" init')
        print()

    print(NEXT_STEPS)
    return 0


def cmd_upgrade(target: Path) -> int:
    if not (target / "AGENTS.md").is_file():
        print(f"does not look like a project with the harness installed: {target}")
        print("if it is new, use `base-harness init`")
        return 1
    changed = []
    for relative in TOOL_OWNED:
        source = TEMPLATE / relative
        if not source.is_file():
            continue
        current = (target / relative).read_bytes() if (target / relative).is_file() else None
        if current == source.read_bytes():
            continue
        write(relative, target)
        changed.append(relative)
    if not changed:
        print("already up to date")
        return 0
    print(f"updated {len(changed)}:")
    for relative in changed:
        print(f"  {relative}")
    print(f"\nUntouched: {', '.join(PROJECT_OWNED)} — they are yours.")
    return 0


NEXT_STEPS = """Two gaps to fill in:

  1. AGENTS.md   the project's limits ("this we do NOT do"), the repo map and
                 the commands. The rest is already written.

  2. .claude/skills/create-plan/SKILL.md   the borrowed pace (5.0 min/task)
                 gets replaced by `base-harness pace` once two plans close.

And check once that Claude Code follows the pointer, by asking it:
"according to AGENTS.md, what limits does this project have?". If it answers,
CLAUDE.md is importing correctly and there is nothing else to maintain.

Then:  pacto init  (if you have not)  and  base-harness plans"""


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    command, rest = argv[0], argv[1:]

    if command in ("init", "upgrade"):
        target = Path(rest[0]).resolve() if rest else Path.cwd()
        return cmd_init(target) if command == "init" else cmd_upgrade(target)

    project = root()
    plan_time.configure(project)
    plans_check.configure(project)

    if command == "check":
        return plans_check.main(["--check"])
    if command == "plans":
        return plans_check.main([])
    if command == "time":
        return plan_time.main(rest)
    if command == "pace":
        return plan_time.main(["--pace", *rest])
    if command == "where":
        print(f"  tool:     {HOME}")
        print(f"  template: {TEMPLATE}")
        print(f"  project:  {project}")
        print(f"  plans:    {project / '.pacto' / 'plans'}")
        return 0
    if command == "version":
        print("base-harness (unversioned: installed from the repo, check its git log)")
        return 0

    print(f"unknown command: {command}\n")
    print(__doc__.strip())
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
