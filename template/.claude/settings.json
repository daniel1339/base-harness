{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(make harness-check:*)",
      "Bash(make harness-sync:*)",
      "Bash(python3 scripts/harness-sync.py:*)",
      "Bash(python3 scripts/plans-check.py:*)",
      "Bash(python3 scripts/plan-time.py:*)",
      "Bash(pacto status:*)",
      "Bash(pacto doctor:*)",
      "Bash(pacto version:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/harness-autosync.py\"",
            "timeout": 30,
            "statusMessage": "Sincronizando adaptadores del harness..."
          }
        ]
      }
    ]
  }
}
